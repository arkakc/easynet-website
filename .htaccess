# ============================================================
# Easynet IT Solutions — Apache / LiteSpeed (cPanel) config
# Mirrors the security headers and caching in vercel.json,
# nginx.conf.example and server.py so every hosting option
# behaves consistently.
# Requires: mod_headers, mod_rewrite. mod_expires optional.
# ============================================================

Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Canonical SEO redirects: remove duplicate homepage URLs.
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+home\.html[\s?] [NC]
  RewriteRule ^home\.html$ / [R=301,L]

  # One-page site policy: old or accidental service URLs should land on the homepage services section.
  RewriteRule ^services(/.*)?$ /#services [R=301,L,NE]

  # Block dotfiles & dot-directories, EXCEPT /.well-known/security.txt (RFC 9116)
  RewriteRule (^|/)\.(?!well-known/security\.txt$) - [R=404,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set X-Robots-Tag "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
  Header always unset X-Powered-By

  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js|png|jpe?g|webp|svg|ico|woff2?|webmanifest|xml|txt)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 7 days"
  ExpiresByType application/javascript    "access plus 7 days"
  ExpiresByType text/javascript           "access plus 7 days"
  ExpiresByType image/png                 "access plus 7 days"
  ExpiresByType image/jpeg                "access plus 7 days"
  ExpiresByType image/webp                "access plus 7 days"
  ExpiresByType image/svg+xml             "access plus 7 days"
  ExpiresByType image/x-icon              "access plus 7 days"
  ExpiresByType image/vnd.microsoft.icon  "access plus 7 days"
  ExpiresByType font/woff2                "access plus 7 days"
</IfModule>

# Block sensitive file types from ever being served.
# Do not block .json globally: valid structured data and app files may need it.
<FilesMatch "\.(md|sql|bak|log|env|py|sh|conf|ini|key|pem|p12|crt|cert|tar|gz|zip|htaccess)$">
  Require all denied
</FilesMatch>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml             .svg
  AddType font/woff2                .woff2
  AddType application/json          .json
</IfModule>
