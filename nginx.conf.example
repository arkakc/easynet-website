# ============================================================
# Easynet IT Solutions — nginx server block (reference)
# Copy into /etc/nginx/conf.d/easynet.conf and adjust paths
# ============================================================

server {
    listen 80;
    server_name easynetpng.com www.easynetpng.com;
    return 301 https://www.easynetpng.com$request_uri;
}

server {
    listen 443 ssl http2;
    server_name easynetpng.com;

    ssl_certificate     /etc/letsencrypt/live/easynetpng.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/easynetpng.com/privkey.pem;

    return 301 https://www.easynetpng.com$request_uri;
}

server {
    listen 443 ssl http2;
    server_name www.easynetpng.com;

    ssl_certificate     /etc/letsencrypt/live/easynetpng.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/easynetpng.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    root  /var/www/easynet;
    index index.html;
    autoindex off;

    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header Cross-Origin-Opener-Policy same-origin always;
    add_header Cross-Origin-Resource-Policy same-origin always;
    add_header X-Robots-Tag "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" always;

    location = /index.html { return 301 /; }
    location = /home.html  { return 301 /; }

    location = /.well-known/security.txt {
        default_type text/plain;
        expires 7d;
        try_files $uri =404;
    }

    # Do not block .json globally: valid structured data/app files may need it.
    location ~* \.(md|sql|bak|log|env|py|sh|conf|ini|key|pem|p12|crt|cert|tar|gz|zip)$ {
        return 404;
    }
    location ~ /\. {
        return 404;
    }

    location ~* \.(css|js|png|jpg|jpeg|webp|svg|ico|woff2|webmanifest|xml|txt|json)$ {
        expires 7d;
        try_files $uri =404;
    }

    location / {
        expires -1;
        try_files $uri $uri/ =404;
    }

    error_page 404 /404.html;
    location = /404.html {
        internal;
    }
}
